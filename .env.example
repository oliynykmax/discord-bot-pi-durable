# Deploy settings. Locally, export these before deploying. In GitHub Actions they live in
# the "production" environment (see .github/workflows/deploy.yml).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Optional custom domain for the bot. Leave empty to use workers.dev.
DEPLOY_DOMAIN=

# Bot variables (pass with --var KEY:VALUE locally, or one KEY:VALUE per line in DEPLOY_VARS):
# GH_APP_ID=            GitHub App ID
# GH_INSTALLATION_ID=   installation of that App on the target repository
# GH_REPO=              owner/name of the repository the bot works on
# SHELL_URL=            optional, wss://<shell-host>/pi-env
# MEMORY_MCP_URL=       optional, https://<shell-host>/mcp

# Worker secrets (uploaded by scripts/provision.sh or `bunx wrangler secret put NAME`):
# DISCORD_TOKEN, GH_APP_PRIVATE_KEY_PKCS8, VERDA_API_KEY, ADMIN_SECRET,
# ALLOWED_USER_IDS, ALLOWED_ROLE_IDS, CHANNEL_IDS, SHELL_TOKEN
