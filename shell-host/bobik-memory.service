[Unit]
Description=bobik's shared memory: Basic Memory MCP over streamable HTTP for the bobik Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bobik
Group=bobik
WorkingDirectory=/home/bobik
Environment=HOME=/home/bobik FASTMCP_CHECK_FOR_UPDATES=off
# Pinned to the project "bobik" (/home/bobik/memory). Caddy checks the shell token before anything reaches it.
ExecStart=/home/bobik/.local/bin/bm mcp --transport streamable-http --host 127.0.0.1 --port 8800 --project bobik
Restart=always
RestartSec=5
# Semantic search loads a local ONNX embedding model on first use, which takes the server from about 220 MB to about
# 390 MB. MemoryHigh pushes it into swap before the hard cap; the box has 1 GB of RAM and the shell may use 600 MB.
MemoryHigh=400M
MemoryMax=450M
TasksMax=64
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
