{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bobik-pi-durable",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "alias": { "node:child_process": "./src/shell/child-process.ts" },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": {
    "bindings": [
      { "name": "GATEWAY", "class_name": "DiscordGateway" },
      { "name": "CONVERSATIONS", "class_name": "Conversation" },
      { "name": "CODEMODE_SANDBOX", "class_name": "CodemodeSandbox", "script_name": "bobik-codemode-sandbox" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DiscordGateway", "Conversation"] }],
  // Operator-specific settings (GH_APP_ID, GH_INSTALLATION_ID, GH_REPO, SHELL_URL, MEMORY_MCP_URL)
  // are passed at deploy time with --var; see .env.example.
  "vars": {
    "GH_BASE_BRANCH": "main",
    "VERDA_BASE_URL": "https://inference.verda.com/v1"
  }
}
