{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bobik-pi-durable",
  "main": "src/worker.ts",
  "account_id": "b9065ca4c59a3d2ebb9430692a07bf2c",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "alias": { "node:child_process": "./src/shell/child-process.ts" },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": {
    "bindings": [
      { "name": "GATEWAY", "class_name": "DiscordGateway" },
      { "name": "CONVERSATIONS", "class_name": "Conversation" },
      { "name": "CODEMODE_SANDBOX", "class_name": "CodemodeSandbox", "script_name": "bobik-codemode-sandbox" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DiscordGateway", "Conversation"] }],
  "vars": {
    "GH_APP_ID": "5745150",
    "GH_INSTALLATION_ID": "181608443",
    "GH_REPO": "oliynykmax/junction-2026",
    "GH_BASE_BRANCH": "main",
    "VERDA_BASE_URL": "https://inference.verda.com/v1",
    "SHELL_URL": "wss://138-2-191-62.sslip.io/pi-env"
  }
}
